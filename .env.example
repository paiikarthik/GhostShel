# GhostShell Environment Configuration
# Copy this file to .env and adjust values as needed.

# Flask Server Configuration (Binds only to localhost for privacy)
HOST=127.0.0.1
PORT=5000
DEBUG=False
SECRET_KEY=change_me_to_a_random_secret_in_production

# Local Ollama AI Engine Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30

# Maximum request payload size in bytes (default 64 KB)
MAX_CONTENT_LENGTH=65536
